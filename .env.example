# ===========================================
# 校园论坛安全配置模板
# 复制此文件为 .env 并填入实际值
# ===========================================

# 服务器配置（端口默认 2080，与 src/config/constants.js 一致）
PORT=2080
NODE_ENV=production

# MongoDB 配置
# ⚠ 若按 docker-compose.yml 部署（mongod 已带 --auth），必须填账号密码；
#   创建/轮换管理员账号见 docker-compose.yml 顶部注释
MONGODB_URI=mongodb://localhost:27017/school-forum
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTHSOURCE=admin
# TLS/SSL（生产环境建议启用）
MONGODB_TLS=false
# MONGODB_TLS_CA_FILE=/path/to/ca.pem
# MONGODB_TLS_CERT_FILE=/path/to/client.pem
# MONGODB_TLS_ALLOW_INVALID_CERTS=false
# 连接池 & 超时（单位毫秒）
MONGODB_SERVER_SELECTION_TIMEOUT=10000
MONGODB_CONNECT_TIMEOUT=10000
MONGODB_SOCKET_TIMEOUT=30000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# Redis 配置
# ⚠ 建议按 /etc/redis/redis.conf 启用 bind 127.0.0.1 + requirepass，
#   并把口令填到 REDIS_PASSWORD（留空时应用按无密码连接）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_USERNAME=          # Redis 6+ ACL 用户名（可选）
# REDIS_DB=0               # 使用的数据库编号
# REDIS_TLS=false          # 生产环境建议启用
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000

# JWT 安全配置
# 请使用强随机字符串，建议 32 字符以上
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 管理员 JWT 配置
ADMIN_JWT_SECRET=your-admin-jwt-secret-key-change-this
ADMIN_JWT_EXPIRES_IN=24h

# 邮件服务配置
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@163.com
SMTP_PASS=your-email-password-or-app-token

# CORS 白名单（多个域名用逗号分隔）
CORS_ORIGIN=http://localhost:2080,http://127.0.0.1:2080

# 安全配置
# 请求体大小限制（MB）
MAX_REQUEST_SIZE=10

# 登录失败锁定配置
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_TIME=1800000

# 密码策略
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=false

# Rate Limit 配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# 安全头 / 反向代理
# CSP 不通过环境变量配置：由 src/config/security.js 的 HELMET_CONFIG 下发，
# 开关与 HSTS 等在 data/config.json 的 security 段（后台「安全设置」）里改。
# 前面挂了 Nginx/CDN 时必须开启，否则 req.ip 全是代理 IP（限流会误伤全站）
TRUST_PROXY=false

# 服务器内网 IP（可选，用于展示/回显，留空自动检测）
SERVER_IP=

# ===========================================
# QQ 互联快捷登录（可选功能，默认不启用）
# 启用步骤：1) 在 https://connect.qq.com 申请网站应用
#           2) 填写下面三项，QQ_REDIRECT_URI 必须与 QQ 互联后台配置一致
#           3) 重启服务，登录页将显示「QQ 快捷登录」按钮
# 不配置则完全不影响系统，登录页仅使用邮箱注册/登录
# ===========================================
QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=
